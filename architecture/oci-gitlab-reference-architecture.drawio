        <mxCell id="notes-title" value="&lt;div style=&quot;line-height:130%;&quot;&gt;Architecture notes&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=25;fontColor=#312D2A;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="3016.0" width="2590" height="37" />
        </mxCell>
        <mxCell id="notes-left" value="&lt;div style=&quot;line-height:130%;&quot;&gt;Ingress: 443 / 80 / 22; IP mode adds Registry 5050 and KAS 8150.&lt;br&gt;Dev bastion: SSH ProxyJump to VMs; port forwarding to the private OKE API.&lt;br&gt;Prod uses private admin routing; the Dev bastion is not provisioned.&lt;br&gt;Dashed paths: administration / egress. NSGs restrict service traffic.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#312D2A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="3062.0" width="1270" height="116" />
        </mxCell>
        <mxCell id="notes-right" value="&lt;div style=&quot;line-height:130%;&quot;&gt;Daily Toolbox backups to Object Storage; PostgreSQL retention is 30 days.&lt;br&gt;Sizes are per node; pod counts are cluster-wide. Same HA app sizing in Dev / Prod.&lt;br&gt;Optional pool: runner_count = 0–6; benchmark Jobs need no registered runner.&lt;br&gt;Source: supplied Terraform / Ansible. DNS and optional access follow inputs.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#312D2A;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="3062.0" width="1260" height="116" />
        </mxCell>
        <mxCell id="repository-storage-footer" vertex="1" parent="1" value="&lt;div style=&quot;line-height:130%;&quot;&gt;Repository storage: 3 × 1 TiB encrypted Block Volumes, one per Gitaly VM, protected by OCI gold backups.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#312D2A;fontStyle=0;spacing=0;">
          <mxGeometry as="geometry" x="50" y="3206" width="2590" height="32" />
        </mxCell>
